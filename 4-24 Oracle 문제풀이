-- [질의 3-4] 가격이 20,000원 미만인 도서를 검색하시오.
   SELECT bookid,bookname,price
   FROM book
   WHERE price<20000;
   
   -- 검색이 많은 컬럼은 인덱스를 이용한다
   CREATE INDEX idx_book_price ON book(price);
   -- full scan 보다는 index를 이용한다 (속도가 더 빠르다)

-- [질의 3-5] 가격이 10,000원 이상 20,000 이하인 도서를 검색하시오.
   -- BETWEEN ~ AND , >= AND <=
   SELECT bookname,price
   FROM book
   WHERE price BETWEEN 10000 AND 20000;
   
   SELECT bookname,price
   FROM book
   WHERE price>=10000 AND price<=20000;
   
   -- 범위 , 기간 => 연산자
-- [질의 3-6] 출판사가 ‘굿스포츠’ 혹은 ‘대한미디어’ 인 도서를 검색하시오.

   SELECT bookname,publisher
   FROM book
   WHERE publisher='굿스포츠' OR publisher='대한미디어';
   
   -- 개선 SQL
   -- IN
    SELECT bookname,publisher
   FROM book
   WHERE publisher IN('굿스포츠','대한미디어');
   /*
     비교 : = , <> , < , > , <= , >= : 문자/날짜
     범위 : BETWEEN ~ AND => 값이 포함 
     집합 : IN , NOT IN
     패턴 : LIKE => REGEXP_LIKE => %_(한글자)
           |일반    |정규식 (패턴)
           :%가 앞에 있는 경우는 인덱스가 적용이 안 된다
           startsWith 단어&
    
     NULL : IS NULL , IS NOT NULL 
            모든 연산은 null값일 경우에는 연산처리가 불가능
     복합조건 : and , or 
   */
   -- 조건 단순화 / 인덱스 탐색시 호율이 증가
   -- 옵티마이저 최적화
   /*
      옵티마이저 : 어떤 순서로 어떤 방식으로 테이블을 읽어야
                가장 빠른 속도인지 결정
      
   */

-- [질의 3-7] ‘축구의 역사’를 출간한 출판사를 검색하시오.
    SELECT publisher
    FROM book
    WHERE bookname='축구의 역사';
          -------- 인덱스 
    -- SQL 튜닝이 없다


-- [질의 3-8] 도서이름에 ‘축구’ 가 포함된 출판사를 검색하시오.
   -- LIKE
   SELECT publisher
   FROM book
   WHERE bookname LIKE '%축구%';
   
    SELECT publisher,bookname
   FROM book
   WHERE bookname LIKE '%축구%' 
   OR bookname LIKE '%야구%'
   OR bookname LIKE '%골프%';
   
    SELECT publisher
   FROM book
   WHERE REGEXP_LIKE(bookname, '축구|야구|골프');
   
   
   -- 1. LIKE , LIKE가 안 되는 경우에 -> REGEXP_LIKE
   -- 2. 여러개 동시에 검색 => REGEXP_LIKE

--[질의 3-9] 도서이름의 왼쪽 두 번째 위치에 ‘구’라는 문자열을 갖는 도서를 검색하시오.
   SELECT bookname
   FROM book
   WHERE bookname LIKE '_구%';
   -- 인덱스 효과가 제한적
   
   SELECT bookname
   FROM book
   WHERE REGEXP_LIKE(bookname , '.구+');

--[질의 3-10] 축구에 관한 도서 중 가격이 20,000원 이상인 도서를 검색하시오.
   SELECT bookname
   FROM book
   WHERE bookname LIKE '%축구%' AND price>20000;
   
   /*
      튜닝
        => 선택도 높은 조건 우선
        => 인덱스 복합 조건 
   */
   SELECT bookname
   FROM book
   WHERE price>20000 and bookname LIKE '%축구%';
   
   -- CREATE INDEX idx_price_name ON book(price,bookname)
   /*
      price 조건으로 먼저 검색
      스캔범위 감소 
   */

--[질의 3-11] 출판사가 ‘굿스포츠’ 혹은 ‘대한미디어’ 인 도서를 검색하시오.
   -- or => in
   SELECT publisher,bookname
   FROM book
