--[질의 3-12] 도서를 이름순으로 검색하시오. 
   -- order by => 정렬
   SELECT bookname
   FROM book
   ORDER BY bookname;
   -- 정렬 컬럼에는 인덱스를 만든다
   CREATE INDEX idx_bookname ON book(bookname ASC);
   
   SELECT bookname
   FROM book
   WHERE bookname>='가';
   
   -- INDEX_ASC INDEX_DESC => pk , uk
   -- SORT 연산을 최소화

