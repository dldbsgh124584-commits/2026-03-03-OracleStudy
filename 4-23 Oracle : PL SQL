-- PL/SQL => FUNCTUON / PROCEDURE / TRIGGER => 웹 개발자 만들어진 내용을 사용
/*
   1. FUNCTION : 리턴값 존재 => SELECT 안에서 주로 사용
                        => 내장함수 : SUBSTR , TRIM , RPAD ...
                        => 사용자 정의 함수(지원하지 않는 함수)
                        => INSERT / UPDATE / DELETE를 사용하지 않는다
                        => SELECT를 이용한다
                        => 계산 , 변환 , 조회
                                              ------
                                              JOIN 데이터
                                     ------- 날짜 , 숫자 변환
                             ------- ROW 단위 계산
   2. PROCEDURE : 작업 수행용 (리턴형이 없다)
                         => 데이터변경 / 트랜잭션 처리
                         => 공통으로 적용되는 기능
   3. TRIGGER : 테이블에서 이벤트가 발생 => 다른 테이블의 데이터 변경
                     => INSERT , UPDATE , DELETE
                     => 반드시 테이블이 다른 경우에만 적용
                     => 입고 = 재고 , 출고 = 재고
                     => 맛집 = 좋아요
                     => 자동화
*/
-- 교재 정리
/*
   SQL
    |
    = DML ==> 단위 row
     1) select : 데이터 검색
     2) insert : 데이터 추가
     3) uptate : 데이터 수정
     4) delete : 데이터 수정
    = ddl ==> 단위 column
     1) create : 생성(정의) => table , view , sequence , index,
                              procedure , function , trigger
     2) alter : 수정
                = add : 추가 ( 컬럼 , 제약조건)
                = modify : 수정
                = drop : 삭제
                = rename : 이름 변경 => 리팩토링
        = 프로젝트 코드 리뷰 / 질문
     3) drop : 완전 삭제
     4) truncate : 데이터 잘라내기 => delete
     5) rename : 테이블명 변경
    ---------------
    = dcl
        = grant : 권한 부여
        = revoke : 권한 해제
    
    = tcl :
        = commit : 정상 저장
        = rollback : 취소 (명령)
        = savepoint : 지정한 위치에서부터 적용
        
    자바
     public void insert()
     {
       try
       {
        getConnection()
        conn.setAutoCommit(false);
        ... select
        ... select
        ...
        conn.commit();
       }catch(exception ex)
       {
        conn.rollback()
       }
       finally
       {       
        conn.setAutoCommit(true)
        dis.connection()
       } 
     }
     
     select
      형식)
        select * | column_list
        from table_name|view_name|select~
        --------------------------------- 필수
        [
           WHERE 연산자
           group by 컬럼|함수
           having 집계함수
           order by 컬럼|함수
        ]
        
        1) SQL 튜닝 => 최적화 / 오라클 부하 
           = 필요한 컬럼만 조회 (select *)
           = i/o 감소 , 네트워크 전송량이 감소
*/

