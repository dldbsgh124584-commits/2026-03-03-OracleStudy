/*
   INSERT INTO 입고 VALUES(100,3,1500)
   :NEW
   :OLD : 이전에 등록된 값
*/

CREATE OR REPLACE TRIGGER 입고_trigger
AFTER INSERT ON 입고
FOR EACH ROW
DECLARE
   v_cnt number;
BEGIN
  -- 상품 재고가 있는지 확인
  SELECT COUNT(*) INTO v_cnt
  FROM 재고
  WHERE 품번=:NEW.품번; -- 입고시에 INSERT로 들어오는 값
  
  IF v_cnt=0 THEN 
    INSERT INTO 재고 VALUES(:NEW.품번,
                           :NEW.수량,
                           :NEW.금액,
                           :NEW.수량*:NEW.금액);
  ELSE
    UPDATE 재고 SET
    수량=수량+:NEW.수량,
    누적금액=누적금액+(:NEW.수량*:NEW.금액)
    WHERE 품번=:NEW.품번;
    -- AutoCommit => COMMIT 사용하면 오류 발생
  END IF;
END;
/

INSERT INTO 입고 VALUES(100,5,1500);
SELECT * FROM 입고;
SELECT * FROM 재고;

-- 출고
CREATE OR REPLACE TRIGGER 출고_trigger
AFTER INSERT ON 출고
FOR EACH ROW
DECLARE
   v_cnt NUMBER;
BEGIN
  SELECT 수량 INTO v_cnt
  FROM 재고
  WHERE 품번 = :NEW.품번;
  
  IF :NEW.수량=v_cnt THEN
    DELETE FROM 재고
    WHERE 품번=:NEW.품번;
  ELSE
     UPDATE 재고 SET
    수량=수량-:NEW.수량,
    누적금액=누적금액-(:NEW.수량*:NEW.금액)
    WHERE 품번=:NEW.품번;    
  END IF;
END;
/

INSERT INTO 출고 VALUES(100,5,1500);
SELECT * FROM 출고;
SELECT * FROM 재고;
